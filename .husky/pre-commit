echo "Running pre-commit checks..."

# Lint-staged: tự động fix lint + prettier
npx lint-staged || {
  echo "❌ Lint-staged failed. Fix errors before commit."
  exit 1
}

# Optional: TypeScript check
if [ -f "tsconfig.json" ]; then
  npx tsc --noEmit || {
    echo "❌ TypeScript type errors. Fix before commit."
    exit 1
  }
fi

echo "✅ All pre-commit checks passed!"
